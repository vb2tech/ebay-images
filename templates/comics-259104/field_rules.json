{
  "_about": "Field rules for the eBay Seller Hub category template, category 259104 (Comics & Graphic Novels). Read by the bulk-upload-validator. Human version: docs/templates/comics-259104-fields.md. To raise our bar, move a field from 'recommended'/'extension' into 'standard' and add a line to threshold_history.",
  "template": {
    "category_id": "259104",
    "category_name": "/Collectibles/Comic Books & Memorabilia/Comics/Comics & Graphic Novels",
    "action_header_prefix": "Action(",
    "header_row_hint": 4,
    "listings_sheet": "Listings",
    "lookup_sheets": ["Categories", "BusinessPolicy", "Aspects", "ListingStaticData"]
  },
  "tiers": {
    "required": "eBay rejects the row without it. Always an ERROR.",
    "conditional": "Required only in a stated situation (see 'when'). ERROR when the situation applies.",
    "standard": "Our project bar: things we can fill confidently from slab photos + research. ERROR in --strict (used by create-bulk-upload), WARNING otherwise.",
    "recommended": "Fill when the item has it. WARNING if empty in --strict, INFO otherwise.",
    "optional": "Never flagged when empty; format-checked when filled.",
    "extension": "Optional item-specific columns that are NOT in eBay's template but exist in eBay's aspect list (added as extra C: columns). Format-checked when present.",
    "not_used": "We don't use these. WARNING if filled."
  },
  "threshold_history": [
    {"date": "2026-11-01", "change": "Initial bar: eBay minimum + all 14 PREFERRED item specifics we can read off a CGC/CBCS slab + SKU + Best Offer."}
  ],
  "fields": {
    "Action":                       {"tier": "required", "allowed": ["Add", "Draft"], "notes": "Template dropdown lists only Add (publishes live). Draft is eBay's drafts-template action; the earlier pipeline used it. Draft is reported as INFO. CONFIRMED 2026-11-01: eBay rejects Draft in this category template (BAF.Error.5); use Add here."},
    "Custom label (SKU)":           {"tier": "standard", "max_len": 50, "unique": true, "notes": "Our SKU = <Grader>-<cert>. Must match the photo filenames in the repo."},
    "Category ID":                  {"tier": "required", "type": "int", "max_len": 10, "notes": "Formula from Category name in the template; the cached value must be 259104."},
    "Category name":                {"tier": "required", "notes": "Drives the Category ID formula. Must be one of the template's Categories."},
    "Title":                        {"tier": "required", "max_len": 80, "notes": "Avoid < > and leading/trailing spaces."},
    "Relationship":                 {"tier": "not_used", "allowed": ["Variation", "Compatibility"]},
    "Relationship details":         {"tier": "not_used"},
    "Schedule Time":                {"tier": "optional", "type": "datetime", "notes": "Must be in the future and within 3 weeks."},
    "P:EPID":                       {"tier": "not_used"},
    "Start price":                  {"tier": "required", "type": "money", "max_len": 16, "min": 0.99},
    "Quantity":                     {"tier": "required", "type": "int", "min": 1, "project_expect": 1, "notes": "Graded slabs are unique, so we expect 1."},
    "Item photo URL":               {"tier": "required", "type": "photo_urls", "max_len": 2048, "max_photos": 24, "warn_photos_over": 12, "notes": "Pipe-separated https URLs, no spaces, image file extension."},
    "VideoID":                      {"tier": "not_used"},
    "Condition ID":                 {"tier": "required", "type": "condition", "notes": "Leading number must be one of the category's condition IDs on the Categories sheet."},
    "Description":                  {"tier": "required", "max_len": 32765, "notes": "Simple HTML only; no scripts."},
    "Format":                       {"tier": "required", "allowed": ["Auction", "FixedPrice"]},
    "Duration":                     {"tier": "required", "notes": "FixedPrice -> GTC. Auction -> 1, 3, 5, 7 or 10."},
    "Buy It Now price":             {"tier": "optional", "type": "money", "notes": "Auction only; at least 30% above Start price."},
    "Best Offer Enabled":           {"tier": "standard", "type": "bool", "notes": "We list with Best Offer on."},
    "Best Offer Auto Accept Price": {"tier": "optional", "type": "money", "notes": "Needs Best Offer on; below Start price."},
    "Minimum Best Offer Price":     {"tier": "optional", "type": "money", "notes": "Needs Best Offer on; below auto-accept and Start price."},
    "Immediate pay required":       {"tier": "optional", "type": "bool"},
    "Location":                     {"tier": "required", "max_len": 45, "notes": "City, ST (no postal code). Required for Action=Add."},
    "Shipping service 1 option":    {"tier": "conditional", "when": "no_shipping_profile", "group": "legacy_shipping"},
    "Shipping service 1 cost":      {"tier": "conditional", "when": "no_shipping_profile", "type": "money0", "group": "legacy_shipping"},
    "Shipping service 1 priority":  {"tier": "optional", "type": "int", "group": "legacy_shipping"},
    "Shipping service 2 option":    {"tier": "optional", "group": "legacy_shipping"},
    "Shipping service 2 cost":      {"tier": "optional", "type": "money0", "group": "legacy_shipping"},
    "Shipping service 2 priority":  {"tier": "optional", "type": "int", "group": "legacy_shipping"},
    "Max dispatch time":            {"tier": "conditional", "when": "no_shipping_profile", "allowed": ["0", "1", "2", "3", "4", "5", "10", "15", "20", "30"], "group": "legacy_shipping"},
    "Returns accepted option":      {"tier": "conditional", "when": "no_return_profile", "allowed": ["ReturnsAccepted", "ReturnsNotAccepted"], "group": "legacy_returns"},
    "Returns within option":        {"tier": "conditional", "when": "returns_accepted", "allowed": ["Days_14", "Days_30", "Days_60"], "group": "legacy_returns"},
    "Refund option":                {"tier": "conditional", "when": "returns_accepted", "allowed": ["MoneyBack", "MoneyBackOrExchange", "MoneyBackOrReplacement"], "group": "legacy_returns"},
    "Return shipping cost paid by": {"tier": "conditional", "when": "returns_accepted", "allowed": ["Buyer", "Seller"], "group": "legacy_returns"},
    "Shipping profile name":        {"tier": "conditional", "when": "no_legacy_shipping", "type": "policy", "policy_col": 0, "max_len": 50},
    "Return profile name":          {"tier": "conditional", "when": "no_legacy_returns", "type": "policy", "policy_col": 1, "max_len": 50},
    "Payment profile name":         {"tier": "conditional", "when": "business_policies", "type": "policy", "policy_col": 2, "max_len": 50},
    "ProductCompliancePolicyID":    {"tier": "not_used"},
    "Regional ProductCompliancePolicies": {"tier": "not_used"},

    "C:Series Title":           {"tier": "standard", "type": "aspect", "closed": false},
    "C:Character":              {"tier": "standard", "type": "aspect", "closed": false, "multi": true},
    "C:Genre":                  {"tier": "standard", "type": "aspect", "closed": false, "multi": true},
    "C:Artist/Writer":          {"tier": "standard", "type": "aspect", "closed": false, "multi": true},
    "C:Publisher":              {"tier": "standard", "type": "aspect", "closed": false},
    "C:Superhero Team":         {"tier": "recommended", "type": "aspect", "closed": false, "multi": true, "notes": "Only when the series is a team book."},
    "C:Publication Year":       {"tier": "standard", "type": "aspect", "closed": false},
    "C:Format":                 {"tier": "standard", "type": "aspect", "closed": true},
    "C:Era":                    {"tier": "standard", "type": "aspect", "closed": true},
    "C:Type":                   {"tier": "standard", "type": "aspect", "closed": false},
    "C:Grade":                  {"tier": "standard", "type": "aspect", "closed": true},
    "C:Tradition":              {"tier": "standard", "type": "aspect", "closed": false},
    "C:Professional Grader":    {"tier": "standard", "type": "aspect", "closed": true},
    "C:Certification Number":   {"tier": "standard", "type": "aspect", "closed": false},

    "C:Issue Number":           {"tier": "extension", "type": "aspect", "closed": false},
    "C:Features":               {"tier": "extension", "type": "aspect", "closed": false, "multi": true},
    "C:Cover Artist":           {"tier": "extension", "type": "aspect", "closed": false, "multi": true},
    "C:Language":               {"tier": "extension", "type": "aspect", "closed": false},
    "C:Signed":                 {"tier": "extension", "type": "aspect", "closed": true},
    "C:Vintage":                {"tier": "extension", "type": "aspect", "closed": true},
    "C:Unit of Sale":           {"tier": "extension", "type": "aspect", "closed": true},
    "C:Variant Type":           {"tier": "extension", "type": "aspect", "closed": false},
    "C:Universe":               {"tier": "extension", "type": "aspect", "closed": false},
    "C:Style":                  {"tier": "extension", "type": "aspect", "closed": true},
    "C:Country of Origin":      {"tier": "extension", "type": "aspect", "closed": false},
    "C:Story Title":            {"tier": "extension", "type": "aspect", "closed": false},
    "C:Intended Audience":      {"tier": "extension", "type": "aspect", "closed": true},

    "Product Safety Pictograms": {"tier": "not_used"},
    "Product Safety Statements": {"tier": "not_used"},
    "Product Safety Component": {"tier": "not_used"},
    "Regulatory Document Ids":  {"tier": "not_used"},
    "Manufacturer *":           {"tier": "not_used", "notes": "EU GPSR contact fields (BF-BO). Only needed if listing to EU buyers."},
    "Responsible Person 1*":    {"tier": "not_used", "notes": "EU GPSR responsible-person fields (BP-BZ)."}
  },
  "aspect_value_max_len": 65,
  "project_checks": {
    "condition_from_grade": [[9.0, "2750"], [6.0, "4000"], [4.0, "5000"], [0.0, "6000"]],
    "title_mentions_grade": true,
    "sku_pattern": "^(CGC|CBCS|PGX|PSA)-[A-Za-z0-9.-]+$",
    "unique": ["Custom label (SKU)", "C:Certification Number"],
    "photo_repo_prefix": "https://raw.githubusercontent.com/vb2tech/ebay-images/main/"
  }
}
